{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eighty", // the Worker keeps its first name: its secrets (RPC_URL, OPENSEA_API_KEY) live on it
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/rpc", "/bids/*", "/ratings", "/edition/*", "/art/*", "/config.json", "/opensea/*", "/ens/*", "/owner/*", "/", "/parties", "/about", "/about/*", "/auctions", "/create", "/unions", "/union/*", "/party/*", "/b/*", "/mint", "/og", "/og/party/*", "/og/sample/*", "/me", "/member/*", "/spin", "/fwa/*"]
  },
  // Public config served at /config.json. Secrets: `wrangler secret put RPC_URL` and `wrangler secret put OPENSEA_API_KEY`.
  "vars": {
    "CHAIN_ID": "11155111",
    "CREDITS": "0xE4aD1a00Eef1E0A8c31544b12D9D7D3B3D377C12",
    "FACTORY": "0x990D3865550E98C70572Fddb20F03C1F1502eD6A",
    "SWEEPER": "0x0000000000000000000000000000000000000000",
    "RATINGS": "0xB30a87D84817458Fcd5EE438A748fE2CdD74C52e",
    "OPENSEA_SLUG": "credits",
    "FALLBACK_RPC": "https://ethereum-sepolia-rpc.publicnode.com",
    // FWA (fwa.fun), mainnet only: its marketplace is a second Buy Credits source; FWA_POOL is the pool /spin sells.
    "FWA_MARKET": "0x2b019cfb591988d28c64c4f4be6a24b1592bbf25",
    "FWA_POOL": "0xfac9af47a396ec1085d3940e2ed16e9b11c62a10",
    // CreditStrategy (nftstrategy.fun), mainnet only: the Credits it holds for sale are a third Buy Credits source.
    "STRATEGY": "0x8e607209899b5d12bd3167a6cd0e8e11feb053d6"
  },
  // Sepolia: SWEEPER stays zero (OpenSea can't list the mock Credits), which hides buy-in.
  // Mainnet addresses go here after DeployMainnet.
  "routes": [
    { "pattern": "creditunion.fun", "custom_domain": true },
    { "pattern": "creditunion.party", "custom_domain": true },
    { "pattern": "eighty.fun", "custom_domain": true },
    { "pattern": "eighty.rhps.fun", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  // Per-IP rate limits (Workers Rate Limiting API). Keys are cf-connecting-ip. RL_RPC counts JSON-RPC calls, not requests.
  "unsafe": {
    "bindings": [
      { "name": "RL_RPC", "type": "ratelimit", "namespace_id": "8001", "simple": { "limit": 1200, "period": 60 } },
      { "name": "RL_QUOTE", "type": "ratelimit", "namespace_id": "8002", "simple": { "limit": 6, "period": 60 } },
      { "name": "RL_MISC", "type": "ratelimit", "namespace_id": "8003", "simple": { "limit": 300, "period": 60 } },
      { "name": "RL_ART", "type": "ratelimit", "namespace_id": "8004", "simple": { "limit": 3000, "period": 60 } }
    ]
  }
}
