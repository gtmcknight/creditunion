{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eighty",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/rpc", "/ratings", "/edition/*", "/art/*", "/config.json", "/opensea/*", "/ens/*"]
  },
  // Public config served at /config.json. Secrets: `wrangler secret put RPC_URL` and `wrangler secret put OPENSEA_API_KEY`.
  "vars": {
    "CHAIN_ID": "11155111",
    "CREDITS": "0x5B60E101635B9FfD12Ed8820BD4F68930088A2eC",
    "FACTORY": "0x672d52f4033fA66190c46933B65d83e52A2dF7BE",
    "SWEEPER": "0x0000000000000000000000000000000000000000",
    "RATINGS": "0x175c1b1C132c0c95C254299e14Bc5D89374fe6Af",
    "OPENSEA_SLUG": "credits",
    "FALLBACK_RPC": "https://ethereum-sepolia-rpc.publicnode.com"
  },
  // Sepolia: SWEEPER stays zero (OpenSea can't list the mock Credits), which hides buy-in.
  // Mainnet addresses go here after DeployMainnet.
  "routes": [
    { "pattern": "eighty.fun", "custom_domain": true },
    { "pattern": "eighty.rhps.fun", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  // Per-IP rate limits (Workers Rate Limiting API). Keys are cf-connecting-ip.
  "unsafe": {
    "bindings": [
      { "name": "RL_RPC", "type": "ratelimit", "namespace_id": "8001", "simple": { "limit": 300, "period": 60 } },
      { "name": "RL_QUOTE", "type": "ratelimit", "namespace_id": "8002", "simple": { "limit": 6, "period": 60 } },
      { "name": "RL_MISC", "type": "ratelimit", "namespace_id": "8003", "simple": { "limit": 300, "period": 60 } },
      { "name": "RL_ART", "type": "ratelimit", "namespace_id": "8004", "simple": { "limit": 3000, "period": 60 } }
    ]
  }
}
