{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eighty", // the Worker keeps its first name (the project was called Eighty): its secrets live on it. A fork renames it.
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/rpc", "/unions.json", "/passes", "/bids/*", "/activity", "/activity.json", "/live", "/ratings", "/edition/*", "/art/*", "/statement/*", "/balance-art/*", "/config.json", "/opensea/*", "/ens", "/ens/*", "/avatar/*", "/owner/*", "/", "/parties", "/about", "/about/*", "/docs", "/docs/*", "/how", "/how/*", "/faq", "/auctions", "/create", "/unions", "/union/*", "/party/*", "/b/*", "/mint", "/og", "/og/party/*", "/og/sample/*", "/me", "/member/*", "/credit/*", "/og/credit/*", "/credits", "/palette", "/palette/*", "/eights", "/eights/*", "/print", "/print/*", "/weight", "/weight/*", "/time", "/rating", "/bits", "/*.bin", "/wall/*", "/plans", "/plans/*", "/pictures/*", "/placed/*", "/allowlist/*", "/market/*", "/statements/*", "/locks/*", "/printer", "/printer/*", "/market.json", "/burns"]
  },
  // Public config served at /config.json. Secrets (`wrangler secret put <NAME>`): RPC_URL, OPENSEA_API_KEY, and optionally
  // OPENSEA_API_KEY_2 (a spare when the first is rate limited), ENS_RPC, KEEPER_KEY (the keeper's gas-only key).
  "vars": {
    "CHAIN_ID": "1",
    "CREDITS": "0x97630aA70AB14ed9883B41dAfccBc11349723043",
    "FACTORY": "0xcb06f9076e5fbF3cB052086b1EE7C0F3836aa051",
    "SWEEPER": "0x7b93309A12e05944Ab821470615983A4A2AC9799",
    "RATINGS": "0x61Ca63cDE107CE7e32785c0d89904fE58f9d371d",
    "STATEMENTS": "0x75Edd94b7e49b3bD5C8047b91F165A5e265a069b",
    "OPENSEA_SLUG": "credits",
    "FALLBACK_RPC": "https://ethereum-rpc.publicnode.com",
    // FWA (fwa.fun), mainnet only: its marketplace is a second Buy Credits source.
    "FWA_MARKET": "0x2b019cfb591988d28c64c4f4be6a24b1592bbf25",
    // CreditStrategy (nftstrategy.fun), mainnet only: the Credits it holds for sale are a third Buy Credits source.
    "STRATEGY": "0x8e607209899b5d12bd3167a6cd0e8e11feb053d6",
    // UnionFormats: where each union's creator picks its Statement format; the burn contract reads it. Zero hides
    // the picker.
    "FORMATS": "0x16deCDa20c9164CcfDB4BE189557aDc4614aAedC",
    "TOKEN_FACTORY": "0x1Ea4b73dE4e946bc58A9A477a7291abe7D7417C1",
    "TOKEN_FORMATS": "0xF3bf99F0a28c4Fc0cf77eB4480F5d0f87d782a25",
    "TOKEN_SWEEPER": "0xA4a4dBFddD6C8cc771F4a013Ccd30494Fc82bC5e",
    // The adapter that converts full batches into BALANCE (the token factory's assembler), and BALANCE itself.
    "TOKEN_ADAPTER": "0xe6492DCCB96D1468302843AEc42Bb39f0FD7BD1D",
    "BALANCE_TOKEN": "0x3620540c994433D7B4a628C46d2ED5F92572eA07",
    // BALANCE's pool as its launch liquidity lock (0xC9951Be5…3b93E) names it, its poolId() this key: 0.3%, tick
    // spacing 30, no hook. And our 1% on swaps to the Safe.
    "BALANCE_POOL_FEE": "3000",
    "BALANCE_POOL_TICK_SPACING": "30",
    "BALANCE_POOL_HOOKS": "0x0000000000000000000000000000000000000000",
    "SWAP_FEE_BPS": "100",
    "SWAP_FEE_TO": "0xFE4761e66C2A37492871d30d0e83bcBC454A7C10"
  },
  // creditunion.party, eighty.fun and eighty.rhps.fun are old names kept so their links still work. A fork puts its own domain here.
  "routes": [
    { "pattern": "creditunion.fun", "custom_domain": true },
    { "pattern": "creditunion.party", "custom_domain": true },
    { "pattern": "eighty.fun", "custom_domain": true },
    { "pattern": "eighty.rhps.fun", "custom_domain": true }
  ],
  // Printer plans and the listings book (/printer): `wrangler kv namespace create PLANS`, then put its id here.
  // Buy locks for Picture unions (src/worker/locks.ts); the market book (market.ts); the chain read once for the site (ChainBook, index.ts).
  "durable_objects": { "bindings": [{ "name": "LOCKS", "class_name": "BuyLocks" }, { "name": "MARKET", "class_name": "MarketBook" }, { "name": "CHAIN", "class_name": "ChainBook" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BuyLocks"] }, { "tag": "v2", "new_sqlite_classes": ["MarketBook"] }, { "tag": "v3", "new_sqlite_classes": ["ChainBook"] }],
  "kv_namespaces": [{ "binding": "PLANS", "id": "87dc2ecb2eca465b84947eb80d2a402f" }],
  "observability": { "enabled": true },
  // Every minute: the market book (market.ts); every 5th, the keeper (keeper.ts), once `wrangler secret put KEEPER_KEY`.
  "triggers": { "crons": ["* * * * *"] },
  // Per-IP rate limits (Workers Rate Limiting API). Keys are cf-connecting-ip. RL_RPC counts JSON-RPC calls, not requests;
  // RL_FILL counts the listings /opensea/buyquote prices (two 40-Credit Printer buys a minute).
  "unsafe": {
    "bindings": [
      { "name": "RL_RPC", "type": "ratelimit", "namespace_id": "8001", "simple": { "limit": 1200, "period": 60 } },
      { "name": "RL_QUOTE", "type": "ratelimit", "namespace_id": "8002", "simple": { "limit": 6, "period": 60 } },
      { "name": "RL_MISC", "type": "ratelimit", "namespace_id": "8003", "simple": { "limit": 300, "period": 60 } },
      { "name": "RL_ART", "type": "ratelimit", "namespace_id": "8004", "simple": { "limit": 3000, "period": 60 } },
      { "name": "RL_FILL", "type": "ratelimit", "namespace_id": "8005", "simple": { "limit": 80, "period": 60 } }
    ]
  }
}
