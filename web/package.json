{
  "name": "creditunion-web",
  "private": true,
  "type": "module",
  "scripts": {
    "abi": "node scripts/abi.mjs",
    "dev": "vite",
    "build": "npm run abi:check && npm run typecheck && vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "abi:check": "node scripts/abi.mjs --check",
    "mirror": "node scripts/mirror.mjs",
    "chain:fork": "node scripts/fork-chain.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "gifenc": "1.0.3",
    "mp4-muxer": "5.2.2",
    "sortablejs": "^1.15.7",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.2",
    "@cloudflare/workers-types": "^5.20260923.1",
    "@types/sortablejs": "^1.15.9",
    "playwright-core": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.144.0"
  }
}
