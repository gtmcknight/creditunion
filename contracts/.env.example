# Copy to contracts/.env and load with: set -a; . ./.env; set +a
# Never commit the real file.

# Mainnet RPC; also read by the fork tests (*.fork.t.sol), which default to a public node
MAINNET_RPC=https://eth-mainnet.example/your-key
# Sepolia RPC, passed as --rpc-url
SEPOLIA_RPC=https://eth-sepolia.example/your-key
# Deployer key, passed as --private-key
PRIVATE_KEY=0xyour_deployer_private_key

# DeployMainnet: required. Receives fees and rescued strays. Immutable.
FEE_RECIPIENT=0x0000000000000000000000000000000000000000
# DeployMainnet / DeployFactory: the one address that may propose the assembler. Use a multisig.
SETTER=0x0000000000000000000000000000000000000000
# DeployMainnet fees in bps. Defaults 200 / 0 / 200, ceilings 500 / 1000 / 500.
PROTOCOL_FEE_BPS=200
CREATOR_FEE_BPS=0
SWEEP_FEE_BPS=200
# DeployMainnet: set only if the adapter exists at deploy (leave unset for stage 1, pooling only).
# An empty value fails to parse, so comment the line out rather than leaving it blank.
# ASSEMBLER=0x...
# DeployMainnet: reuse an existing score table instead of deploying one. Required by DeployFactory.
# RATINGS=0x...

# DeployTestnet: true = no assembler at deploy, like mainnet stage 1
STAGED=false

# DeployFactory (Sepolia): existing test Credits
# CREDITS=0x...
